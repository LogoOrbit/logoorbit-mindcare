{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/zohoverify/verifyforzoho.html",
      "destination": "/api/zohoverify"
    },
    {
      "source": "/zohoverify/verifyforzoho",
      "destination": "/api/zohoverify"
    },
    {
      "source": "/submissions",
      "destination": "/api/submissions"
    }
  ],
  "headers": [
    {
      "source": "/submissions",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
